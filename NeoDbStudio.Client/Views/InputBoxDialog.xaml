<Window x:Class="NeoDbStudio.Client.Views.InputBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="NeoDB Studio" Height="180" Width="440" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#F0F0F0" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Text="名前を入力してください:" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" Height="28" VerticalContentAlignment="Center"
                 Background="#252526" Foreground="#F0F0F0" BorderBrush="#3F3F46"
                 KeyDown="InputTextBox_KeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Content="OK" Width="90" Height="30" IsDefault="True" Background="#0E639C" Foreground="White" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
