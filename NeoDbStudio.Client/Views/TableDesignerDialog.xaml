<Window x:Class="NeoDbStudio.Client.Views.TableDesignerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Table Designer"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Column DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock x:Name="TxtTableName" Text="🛠 Table Designer: TableName" FontSize="18" FontWeight="Bold" Foreground="#1E90FF" VerticalAlignment="Center"/>
            <Border x:Name="BadgeRealSchema" Background="#2E8B57" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Loaded from live schema" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnAddColumn" Content="➕ Add Column" Click="BtnAddColumn_Click" Height="32" Padding="12,0" Margin="0,0,8,0"/>
            <Button x:Name="BtnRemoveColumn" Content="➖ Remove Selected" Click="BtnRemoveColumn_Click" Height="32" Padding="12,0"/>
        </StackPanel>

        <!-- Column Grid -->
        <DataGrid x:Name="ColumnsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="All" HeadersVisibility="Column" Margin="0,0,0,14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Column Name" Binding="{Binding ColumnName, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                <DataGridTextColumn Header="Data Type" Binding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey, UpdateSourceTrigger=PropertyChanged}" Width="0.5*"/>
                <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding AllowNull, UpdateSourceTrigger=PropertyChanged}" Width="0.6*"/>
                <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                <DataGridTextColumn Header="Comment" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="変更を加えると「Generate ALTER TABLE」でDDLスクリプトを生成できます（自動実行はしません）。" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="BtnGenerateAlter" Grid.Column="1" Content="⚙ Generate ALTER TABLE" Click="BtnGenerateAlter_Click" Background="#DAA520" Foreground="White" Height="34" Padding="14,0" FontWeight="Bold" Margin="0,0,8,0"/>
            <Button x:Name="BtnClose" Grid.Column="2" Content="Close" Click="BtnClose_Click" Height="34" Padding="18,0"/>
        </Grid>
    </Grid>
</Window>
