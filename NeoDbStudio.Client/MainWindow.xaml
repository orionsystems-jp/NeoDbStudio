<Window x:Class="NeoDbStudio.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns:models="clr-namespace:NeoDbStudio.Client.Models"
        xmlns:converters="clr-namespace:NeoDbStudio.Client.Converters"
        xmlns:helpers="clr-namespace:NeoDbStudio.Client.Helpers"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="NeoDB Studio - Advanced Database Studio &amp; Engineering Tool" 
        Height="900" Width="1450" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Standard & Custom Value Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:DebugStateColorConverter x:Key="DebugStateColorConverter"/>
            <converters:DebugStateTextConverter x:Key="DebugStateTextConverter"/>

            <!-- Top-Level MenuBar Item Style for Clear Graying Out when Disabled -->
            <Style x:Key="MenuBarItemStyle" TargetType="MenuItem">
                <Setter Property="Foreground" Value="#F0F0F0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#666666"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewQueryTabCommand}"/>
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ExecuteQueryCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}"/>
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="RootGrid" Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Classic MenuBar & Header -->
            <RowDefinition Height="*"/>    <!-- Strictly Separated Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ==================================================================== -->
        <!-- 1. Integrated MenuBar & Header Area                                  -->
        <!-- ==================================================================== -->
        <Border Grid.Row="0" x:Name="HeaderBorder" Background="#2D2D30" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Classic MenuBar -->
                    <RowDefinition Height="Auto"/> <!-- Header Title & Theme/Language ComboBoxes -->
                    <RowDefinition Height="Auto"/> <!-- Modern Ribbon Bar (Active Project Only) -->
                </Grid.RowDefinitions>

                <!-- Row 0: Classic MenuBar (Strict Graying Out Style & IsEnabled Bindings for Optimal UI/UX) -->
                <Menu Grid.Row="0" x:Name="MainMenu" Background="Transparent" Foreground="#F0F0F0" Padding="4,2">
                    <MenuItem x:Name="MenuFile" Style="{StaticResource MenuBarItemStyle}" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_File]}">
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_NewProject]}" Command="{Binding NewProjectCommand}"/>
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_OpenProject]}" Command="{Binding OpenProjectCommand}"/>
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_OpenSqlFile]}" Command="{Binding OpenSqlFileCommand}"/>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_RecentProjects]}" ItemsSource="{Binding RecentProjects}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding DisplayText}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_ClearRecent]}" Command="{Binding ClearRecentProjectsCommand}"/>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_Save]}" IsEnabled="{Binding HasActiveProject}" Command="{Binding SaveProjectCommand}"/>
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_SaveAs]}" IsEnabled="{Binding HasActiveProject}" Command="{Binding SaveProjectAsCommand}"/>
                        <Separator/>
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_Exit]}" Command="{Binding ExitAppCommand}"/>
                    </MenuItem>

                    <MenuItem x:Name="MenuEdit" Style="{StaticResource MenuBarItemStyle}" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_Edit]}" IsEnabled="{Binding HasActiveProject}">
                        <MenuItem Header="↩ 元に戻す / Undo (Ctrl+Z)" IsEnabled="{Binding HasActiveProject}" Command="{Binding UndoCommand}"/>
                        <MenuItem Header="↪ やり直し / Redo (Ctrl+Y)" IsEnabled="{Binding HasActiveProject}" Command="{Binding RedoCommand}"/>
                        <Separator/>
                        <MenuItem Header="✂ 切り取り / Cut (Ctrl+X)" IsEnabled="{Binding HasActiveProject}" Command="{Binding CutCommand}"/>
                        <MenuItem Header="📋 コピー / Copy (Ctrl+C)" IsEnabled="{Binding HasActiveProject}" Command="{Binding CopyCommand}"/>
                        <MenuItem Header="📌 貼り付け / Paste (Ctrl+V)" IsEnabled="{Binding HasActiveProject}" Command="{Binding PasteCommand}"/>
                    </MenuItem>

                    <!-- View Menu (Disabled Parent & Children when No Project is Open, Visually Grayed Out) -->
                    <MenuItem x:Name="MenuView" Style="{StaticResource MenuBarItemStyle}" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_View]}" IsEnabled="{Binding HasActiveProject}">
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_NewQuery]}" IsEnabled="{Binding HasActiveProject}" Command="{Binding NewQueryTabCommand}"/>
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_TableDesigner]}" IsEnabled="{Binding HasActiveProject}" Command="{Binding OpenTableDesignerCommand}"/>
                    </MenuItem>

                    <!-- Database Menu (Disabled Parent & Children when No Project is Open, Visually Grayed Out) -->
                    <MenuItem x:Name="MenuDatabase" Style="{StaticResource MenuBarItemStyle}" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_Database]}" IsEnabled="{Binding HasActiveProject}">
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_ConnectionWizard]}" IsEnabled="{Binding HasActiveProject}" Command="{Binding OpenConnectionWizardCommand}"/>
                        <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_LoadSchema]}" IsEnabled="{Binding HasActiveProject}" Command="{Binding LoadSchemaCommand}"/>
                    </MenuItem>

                    <!-- Debug Menu (Disabled Parent & Children when No Project is Open, Visually Grayed Out) -->
                    <MenuItem x:Name="MenuDebug" Style="{StaticResource MenuBarItemStyle}" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_Debug]}" IsEnabled="{Binding HasActiveProject}">
                        <MenuItem Header="🐞 デバッグ開始 [試作版] (Start Debug Preview)" IsEnabled="{Binding HasActiveProject}" Command="{Binding StartDebugCommand}"/>
                        <MenuItem Header="⤵ Step Over (F10)" IsEnabled="{Binding IsDebugging}" Command="{Binding StepOverDebugCommand}"/>
                        <MenuItem Header="▶ Continue" IsEnabled="{Binding IsDebugging}" Command="{Binding ContinueDebugCommand}"/>
                        <MenuItem Header="⏹ Stop Debug" IsEnabled="{Binding IsDebugging}" Command="{Binding StopDebugCommand}"/>
                    </MenuItem>

                    <MenuItem x:Name="MenuHelp" Style="{StaticResource MenuBarItemStyle}" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_Help]}">
                        <MenuItem Header="📜 サードパーティライセンス情報 (Licenses)" Command="{Binding ShowLicensesCommand}"/>
                        <Separator/>
                        <MenuItem Header="❓ NeoDB Studio について (About)" Command="{Binding ShowAboutCommand}"/>
                    </MenuItem>
                </Menu>

                <!-- Row 1: Title Badge & Clean Active Project Badge -->
                <Grid Grid.Row="1" Margin="12,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ NeoDB Studio" FontSize="16" FontWeight="ExtraBold" Foreground="#1E90FF" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        
                        <!-- Clean Interactive Active Project Badge (Click to open Connection Wizard Dialog) -->
                        <Button Command="{Binding OpenConnectionWizardCommand}" Background="#3E3E42" BorderBrush="#555555" BorderThickness="1" ui:ControlHelper.CornerRadius="4" Padding="10,4" Margin="0,0,10,0" ToolTip="クリックすると接続詳細設定ダイアログが表示されます (Click to open Connection Wizard Dialog)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Label_ActiveProject]}" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProjectName}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasActiveProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text=" [" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedProvider}" Foreground="#1E90FF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="]" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text=" 🔌" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Language Selector & Color Theme ComboBoxes -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LblLanguage" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Label_Language]}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" SelectedIndex="0" Width="170" Height="30" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <TextBlock x:Name="LblTheme" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Label_Theme]}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" SelectedIndex="0" DisplayMemberPath="Name" Width="170" Height="30" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Modern Ribbon Bar Tabs (Clean Single Icon per Button guaranteed) -->
                <TabControl x:Name="RibbonTabControl" Grid.Row="2" Margin="0,2,0,0" Padding="0" Visibility="{Binding HasActiveProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabItem x:Name="TabHome" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Tab_Home]}">
                        <Border Padding="10,8" Background="#252526">
                            <WrapPanel Orientation="Horizontal">
                                <Border BorderBrush="#3F3F46" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Single Clean Icon Buttons -->
                                        <Button Command="{Binding NewQueryTabCommand}" Background="#1E90FF" Foreground="White" Height="38" Padding="14,0" ui:ControlHelper.CornerRadius="4" FontWeight="Bold" Margin="0,0,6,0">
                                            <TextBlock x:Name="TxtBtnNewQuery" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_NewQuery]}" VerticalAlignment="Center" FontSize="13"/>
                                        </Button>
                                        <Button Command="{Binding ExecuteQueryCommand}" IsEnabled="{Binding HasActiveProject}" Background="#2E8B57" Foreground="White" Height="38" Padding="16,0" ui:ControlHelper.CornerRadius="4" FontWeight="Bold">
                                            <TextBlock x:Name="TxtBtnExecuteQuery" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_ExecuteQuery]}" VerticalAlignment="Center" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="#3F3F46" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding NewProjectCommand}" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_NewProject]}" Margin="0,0,6,0" Height="38"/>
                                        <Button Command="{Binding OpenProjectCommand}" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_OpenProject]}" Margin="0,0,6,0" Height="38"/>
                                        <Button Command="{Binding OpenSqlFileCommand}" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_OpenSqlFile]}" Margin="0,0,6,0" Height="38"/>
                                        <Button Command="{Binding SaveProjectCommand}" IsEnabled="{Binding HasActiveProject}" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Menu_Save]}" Height="38"/>
                                    </StackPanel>
                                </Border>

                                <Border Padding="0,0,6,0" IsEnabled="{Binding HasActiveProject}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding UndoCommand}" Content="↩ Undo" Margin="0,0,6,0" Height="38"/>
                                        <Button Command="{Binding RedoCommand}" Content="↪ Redo" Margin="0,0,6,0" Height="38"/>
                                        <Button Command="{Binding CopyCommand}" Content="📋 Copy" Margin="0,0,6,0" Height="38"/>
                                        <Button Command="{Binding CutCommand}" Content="✂ Cut" Margin="0,0,6,0" Height="38"/>
                                        <Button Command="{Binding PasteCommand}" Content="📌 Paste" Height="38"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <TabItem x:Name="TabEngineering" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Tab_Engineering]}" IsEnabled="{Binding HasActiveProject}">
                        <Border Padding="10,8" Background="#252526">
                            <WrapPanel Orientation="Horizontal">
                                <Button Command="{Binding OpenConnectionWizardCommand}" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_ConnectionWizard]}" Height="38" Margin="0,0,8,0"/>
                                <Button Command="{Binding OpenTableDesignerCommand}" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_TableDesigner]}" Height="38" Margin="0,0,12,0"/>
                                <Button Command="{Binding OpenSchemaDiffCommand}" Content="🔍 Compare Schemas" Height="38" Margin="0,0,12,0"/>
                                <Button Command="{Binding LoadSchemaCommand}" Background="#008080" Foreground="White" Height="38" Padding="14,0" ui:ControlHelper.CornerRadius="4" FontWeight="Bold">
                                    <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_LoadSchema]}" VerticalAlignment="Center" FontSize="13"/>
                                </Button>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <TabItem x:Name="TabDebugger" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Tab_Debugger]}" IsEnabled="{Binding HasActiveProject}">
                        <Border Padding="10,8" Background="#252526">
                            <WrapPanel Orientation="Horizontal">
                                <Button Command="{Binding StartDebugCommand}" IsEnabled="{Binding IsDebugging, Converter={StaticResource InverseBoolConverter}}" Background="#DAA520" Foreground="White" Height="38" Padding="14,0" ui:ControlHelper.CornerRadius="4" FontWeight="Bold" Margin="0,0,8,0">
                                    <TextBlock Text="🐞 デバッグ開始 (Start Debug)" VerticalAlignment="Center" FontSize="13"/>
                                </Button>
                                <Button Command="{Binding StepOverDebugCommand}" IsEnabled="{Binding IsDebugging}" Content="⤵ Step Over (F10)" Height="38" Margin="0,0,6,0"/>
                                <Button Command="{Binding ContinueDebugCommand}" IsEnabled="{Binding IsDebugging}" Content="▶ Continue" Height="38" Margin="0,0,6,0"/>
                                <Button Command="{Binding StopDebugCommand}" IsEnabled="{Binding IsDebugging}" Content="⏹ Stop Debug" Height="38" Margin="0,0,16,0"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Debug Status:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#F0F0F0"/>
                                    <Border Background="{Binding IsDebugging, Converter={StaticResource DebugStateColorConverter}}" Padding="8,4" CornerRadius="4">
                                        <TextBlock Text="{Binding IsDebugging, Converter={StaticResource DebugStateTextConverter}}" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- ==================================================================== -->
        <!-- 2. Main Studio Area: Professional 2-Column Welcome Hub vs Workspace  -->
        <!-- ==================================================================== -->
        <Grid Grid.Row="1">
            <!-- CONTAINER A: Professional 2-Column Welcome Hub (HasActiveProject == FALSE) -->
            <ScrollViewer x:Name="StartPageScrollViewer" Visibility="{Binding HasActiveProject, Converter={StaticResource InverseBoolToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" Background="#181818">
                <Grid Margin="35,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Hero Banner -->
                        <RowDefinition Height="*"/>    <!-- 2-Column Professional Hub -->
                    </Grid.RowDefinitions>

                    <!-- Hero Banner -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,25">
                        <TextBlock Text="⚡ Welcome to NeoDB Studio" FontSize="28" FontWeight="ExtraBold" Foreground="#1E90FF" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtStartSubtitle" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_Subtitle]}" FontSize="13" Foreground="#AAAAAA"/>
                    </StackPanel>

                    <!-- 2-Column Layout (Left: Recent Connections 65% / Right: Quick Actions 35%) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="35*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Recent Projects & DBMS Connection History List (Clean Single Icon Button & Multilingual Search) -->
                        <Border x:Name="CardBorderHistory" Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Title -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtStartRecentTitle" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_RecentTitle]}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Real-time History Search Filter Box -->
                                <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍 " Foreground="#888888" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                        <TextBox x:Name="TxtHistorySearch" Grid.Column="1" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" VerticalAlignment="Center" ui:ControlHelper.PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_SearchPlaceholder]}"/>
                                    </Grid>
                                </Border>

                                <!-- Scrollable Clean ListBox with Single Icon Action Button -->
                                <ScrollViewer x:Name="HistoryScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="450" PreviewMouseWheel="HistoryScrollViewer_PreviewMouseWheel">
                                    <ListBox ItemsSource="{Binding FilteredRecentProjects}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="12,14" Margin="0,0,0,6" Background="#2D2D30" CornerRadius="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/> <!-- Left Fixed Action Button -->
                                                            <ColumnDefinition Width="15"/>
                                                            <ColumnDefinition Width="*"/>    <!-- Project & Connection Details -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- COLUMN 0: Left Fixed Action Button (Clean Single Icon) -->
                                                        <Button Grid.Column="0" Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#2E8B57" Foreground="White" Height="36" Padding="16,0" ui:ControlHelper.CornerRadius="4" FontWeight="Bold" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_ConnectOpen]}" VerticalAlignment="Center" FontSize="12"/>
                                                        </Button>

                                                        <!-- COLUMN 2: Right Info (Name, Badge, Connection String) -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <TextBlock Text="🗄 " Foreground="#1E90FF" FontSize="16" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ProjectName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center"/>
                                                                <Border Background="#1E90FF" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ProviderType}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding MaskedConnectionString}" Foreground="#AAAAAA" FontSize="11" TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- RIGHT COLUMN: Quick DBMS Actions & Guidance (100% Dynamic Multilingual) -->
                        <StackPanel Grid.Column="2">
                            <!-- Card 1: New Project / DBMS Connection Wizard -->
                            <Border x:Name="CardBorder1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStartNewConnTitle" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_NewConnTitle]}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtStartNewConnDesc" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_NewConnDesc]}" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,15" FontSize="12"/>
                                    <Button Command="{Binding NewProjectCommand}" Background="#1E90FF" Foreground="White" Height="42" HorizontalAlignment="Stretch" FontWeight="Bold">
                                        <TextBlock x:Name="TxtStartNewConnBtn" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_NewConnBtn]}" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Open Saved Project File -->
                            <Border x:Name="CardBorder2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStartOpenProjTitle" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_OpenProjTitle]}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtStartOpenProjDesc" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_OpenProjDesc]}" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,15" FontSize="12"/>
                                    <Button Command="{Binding OpenProjectCommand}" Background="#3E3E42" Foreground="White" Height="42" HorizontalAlignment="Stretch" FontWeight="Bold">
                                        <TextBlock x:Name="TxtStartOpenProjBtn" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_OpenProjBtn]}" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Interactive Architecture Guidance Notice & Connection Trigger -->
                            <Button Command="{Binding NewProjectCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                                <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtStartNoticeTitle" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_NoticeTitle]}" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" FontSize="13"/>
                                            <TextBlock x:Name="TxtStartNoticeDesc" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Start_NoticeDesc]}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="🔌" FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- CONTAINER B: Full Active Studio Workspace (HasActiveProject == TRUE) -->
            <Grid Visibility="{Binding HasActiveProject, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <!-- DBMS Object Explorer with Dynamic ContextMenu per Node Type (100% Reliable Click Event Handlers) -->
                    <Border Grid.Column="0" x:Name="ExplorerBorder" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtExplorerTitle" Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Label_ObjectExplorer]}" FontWeight="Bold" Margin="4,4,4,6" Foreground="#1E90FF"/>
                            
                            <TreeView x:Name="TvDbObjects" Grid.Row="1" ItemsSource="{Binding DbObjectTree}" MouseDoubleClick="TvDbObjects_MouseDoubleClick">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2" Background="Transparent">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu x:Name="TreeContextMenu">
                                                    <!-- Table Specific Commands (100% Direct Reliable Event Triggers) -->
                                                    <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Table_ScriptSelect]}" Click="MenuItem_ScriptSelect_Click"/>
                                                    <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Table_ScriptInsert]}" Click="MenuItem_ScriptInsert_Click"/>
                                                    <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Table_ScriptUpdate]}" Click="MenuItem_ScriptUpdate_Click"/>
                                                    <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Table_ScriptDelete]}" Click="MenuItem_ScriptDelete_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Table_ScriptCreate]}" Click="MenuItem_ScriptCreate_Click"/>
                                                    <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Table_ScriptDrop]}" Click="MenuItem_ScriptDrop_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Table_DesignTable]}" Click="MenuItem_DesignTable_Click"/>
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#3F3F46"/>

                    <!-- Center Area: True Multi-Tab Query Tabs Binding & Floating Undocking Window Support -->
                    <Border Grid.Column="2" x:Name="CenterBorder" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="4">
                    <TabControl x:Name="CenterAreaTabControl">
                    <TabItem Header="📝 SQL Query">
                        <TabControl x:Name="MainTabControl" ItemsSource="{Binding QueryTabs}" SelectedItem="{Binding ActiveQueryTab, Mode=TwoWay}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📝 " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- Float Undocking Window Button -->
                                        <Button Click="BtnFloatTab_Click" Background="Transparent" BorderThickness="0" Padding="4,1" Margin="0,0,4,0" ToolTip="このクエリタブを独立ウィンドウとして分離 (Float Window)">
                                            <TextBlock Text="🗔" FontSize="11" Foreground="#1E90FF"/>
                                        </Button>

                                        <!-- Close Tab Button -->
                                        <Button Click="BtnCloseTab_Click" Background="Transparent" BorderThickness="0" Padding="3,1" ToolTip="タブを閉じる">
                                            <TextBlock Text="✕" FontSize="11" Foreground="#FF6B6B" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>

                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1.2*"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- SQL Editor Mini Header & Direct Execution Toolbar -->
                                            <Grid Grid.Row="0" Margin="6,4,6,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="SQL Query / Stored Procedure Script:" FontWeight="Bold" VerticalAlignment="Center"/>

                                                <CheckBox Grid.Column="1" IsChecked="{Binding AutoCommit, Mode=TwoWay}" Content="Autocommit" Foreground="#F0F0F0" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="OFFにすると、Commit/Rollbackを実行するまで同一トランザクション上でクエリを継続実行します"/>

                                                <Button Grid.Column="2" Command="{Binding CommitCommand}" IsEnabled="{Binding IsInTransaction}" Background="#1E6091" Foreground="White" Height="30" Padding="12,0" Margin="0,0,6,0" ui:ControlHelper.CornerRadius="4" FontWeight="Bold" ToolTip="トランザクションをコミット">
                                                    <TextBlock Text="Commit" VerticalAlignment="Center" FontSize="12"/>
                                                </Button>

                                                <Button Grid.Column="3" Command="{Binding RollbackCommand}" IsEnabled="{Binding IsInTransaction}" Background="#8B3A3A" Foreground="White" Height="30" Padding="12,0" Margin="0,0,10,0" ui:ControlHelper.CornerRadius="4" FontWeight="Bold" ToolTip="トランザクションをロールバック">
                                                    <TextBlock Text="Rollback" VerticalAlignment="Center" FontSize="12"/>
                                                </Button>

                                                <Button Grid.Column="4" Command="{Binding DataContext.ShowExecutionPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="#555555" Foreground="White" Height="30" Padding="10,0" Margin="0,0,10,0" ui:ControlHelper.CornerRadius="4" FontWeight="Bold" ToolTip="実行計画を新しいタブへ表示（EXPLAIN）">
                                                    <TextBlock Text="📊 Plan" VerticalAlignment="Center" FontSize="12"/>
                                                </Button>

                                                <Button Grid.Column="5" Command="{Binding DataContext.ExecuteQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="#2E8B57" Foreground="White" Height="30" Padding="12,0" ui:ControlHelper.CornerRadius="4" FontWeight="Bold">
                                                    <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Btn_ExecuteQuery]}" VerticalAlignment="Center" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                            
                                            <!-- SQL Editor (Loaded, TextChanged, DataContextChanged Handlers Attached for 100% Guaranteed Synchronization) -->
                                            <avalonEdit:TextEditor x:Name="SqlEditor" Grid.Row="1" FontFamily="Consolas" FontSize="14" Foreground="#569CD6" ShowLineNumbers="True" Loaded="SqlEditor_Loaded" TextChanged="SqlEditor_TextChanged" DataContextChanged="SqlEditor_DataContextChanged" Margin="4">
                                                <avalonEdit:TextEditor.ContextMenu>
                                                    <ContextMenu x:Name="SqlEditorContextMenu">
                                                        <MenuItem x:Name="CtxEditExecute" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Edit_Execute]}" Command="{Binding DataContext.ExecuteQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <Separator/>
                                                        <MenuItem x:Name="CtxEditUndo" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Edit_Undo]}" Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <MenuItem x:Name="CtxEditRedo" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Edit_Redo]}" Command="{Binding DataContext.RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <Separator/>
                                                        <MenuItem x:Name="CtxEditCut" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Edit_Cut]}" Command="{Binding DataContext.CutCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <MenuItem x:Name="CtxEditCopy" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Edit_Copy]}" Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <MenuItem x:Name="CtxEditPaste" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Edit_Paste]}" Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </ContextMenu>
                                                </avalonEdit:TextEditor.ContextMenu>
                                            </avalonEdit:TextEditor>
                                        </Grid>

                                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#3F3F46"/>

                                        <!-- Query Result Set DataGrid & Paging Bar -->
                                        <Grid Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Paging Navigation Bar -->
                                            <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="6,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Label_ResultDataGrid]}" FontWeight="Bold" Foreground="#1E90FF"/>
                                                        <TextBlock Text="{Binding TotalRowCount}" FontWeight="Bold" Foreground="#1E90FF"/>
                                                        <TextBlock Text=" rows total):" FontWeight="Bold" Foreground="#1E90FF"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Label_PageSize]}" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11" Margin="0,0,4,0"/>
                                                        <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay}" Width="75" Height="26" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"/>

                                                        <Button Command="{Binding FirstPageCommand}" Content="⏮" Width="30" Height="26" Margin="0,0,3,0" Padding="0" ToolTip="最初のページ"/>
                                                        <Button Command="{Binding PreviousPageCommand}" Content="◀" Width="30" Height="26" Margin="0,0,8,0" Padding="0" ToolTip="前のページ"/>

                                                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Label_Page]}" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="12"/>
                                                        <TextBlock Text="{Binding PageIndex}" FontWeight="Bold" Foreground="#1E90FF" VerticalAlignment="Center" FontSize="12"/>
                                                        <TextBlock Text=" / " VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="12"/>
                                                        <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>

                                                        <Button Command="{Binding NextPageCommand}" Content="▶" Width="30" Height="26" Margin="0,0,3,0" Padding="0" ToolTip="次のページ"/>
                                                        <Button Command="{Binding LastPageCommand}" Content="⏭" Width="30" Height="26" Padding="0" ToolTip="最後のページ"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Virtualized DataGrid（インライン編集可・単一テーブル＋主キー特定可能時のみUPDATEを自動生成） -->
                                            <DataGrid x:Name="ResultGrid" Grid.Row="1" ItemsSource="{Binding ResultTable}" AutoGenerateColumns="True" IsReadOnly="False" GridLinesVisibility="All"
                                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                      RowEditEnding="ResultGrid_RowEditEnding"
                                                      AutoGeneratingColumn="ResultGrid_AutoGeneratingColumn"
                                                      PreviewMouseDoubleClick="ResultGrid_PreviewMouseDoubleClick"
                                                      Margin="4">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu x:Name="GridContextMenu">
                                                        <MenuItem x:Name="CtxGridCopyCell" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Grid_CopyCell]}" Click="MenuItem_GridCopyCell_Click"/>
                                                        <MenuItem x:Name="CtxGridCopyRow" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Grid_CopyRow]}" Click="MenuItem_GridCopyRow_Click"/>
                                                        <Separator/>
                                                        <MenuItem x:Name="CtxGridExportCsv" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Grid_ExportCsv]}" Click="MenuItem_GridExportCsv_Click"/>
                                                        <MenuItem x:Name="CtxGridExportJson" Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Ctx_Grid_ExportJson]}" Click="MenuItem_GridExportJson_Click"/>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </TabItem>

                    <!-- ER Diagram Tab: MSAGL GraphViewer host panel（スキーマ単位分割表示＋テーブル絞り込み＋PNG/Excelエクスポート機能付き） -->
                    <TabItem Header="🗺 ER Diagram">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,6">
                                <TextBlock Text="スキーマ:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CmbErDiagramSchema" Width="220" Margin="0,0,12,0"
                                          ItemsSource="{Binding ErDiagramSchemas}"
                                          SelectedItem="{Binding SelectedErDiagramSchema}"/>
                                <Button x:Name="BtnResetErView" Content="🔄 Reset View" Click="BtnResetErView_Click" Height="30" Padding="10,0" Margin="0,0,8,0"/>
                                <Button x:Name="BtnExportErPng" Content="📷 Export as PNG" Click="BtnExportErPng_Click" Height="30" Padding="10,0" Margin="0,0,8,0"/>
                                <Button Content="📊 Export Schema to Excel" Command="{Binding ExportSchemaToExcelCommand}" Height="30" Padding="10,0"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#3F3F46" BorderThickness="0,0,1,0" Padding="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="表示するテーブル/ビュー:" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <ListBox Grid.Row="1" ItemsSource="{Binding ErDiagramTableChoices}" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button Content="全選択" Command="{Binding SelectAllErDiagramTablesCommand}" Padding="8,4" Margin="0,0,6,0"/>
                                                <Button Content="全解除" Command="{Binding DeselectAllErDiagramTablesCommand}" Padding="8,4"/>
                                            </StackPanel>
                                            <Button Content="✅ 適用 (Apply Filter)" Command="{Binding ApplyErDiagramFilterCommand}" Padding="8,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid x:Name="GViewerHost" Grid.Column="1" Background="White"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    </TabControl>
                    </Border>

                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#3F3F46"/>

                    <Border Grid.Column="4" x:Name="RightBorder" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="🔍 Variable Watch Panel" FontWeight="Bold" Margin="4,4,4,6" Foreground="#1E90FF"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DebugVariables}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Variable" Binding="{Binding Name}" Width="1*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="1*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#3F3F46"/>

                <Border Grid.Row="2" x:Name="BottomBorder" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="4">
                    <TabControl Margin="2">
                        <TabItem Header="📜 System Execution Logs">
                            <ListBox ItemsSource="{Binding ExecutionLogs}" FontFamily="Consolas" FontSize="11" Margin="4"/>
                        </TabItem>
                        <TabItem Header="🕒 Query History">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Command="{Binding ClearQueryHistoryCommand}" Content="🗑 Clear History" HorizontalAlignment="Right" Height="26" Padding="8,0" Margin="4,4,4,4"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding QueryHistory}" FontFamily="Consolas" FontSize="11" Margin="4"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="📎 SQL Snippets">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                                    <Button Command="{Binding SaveCurrentQueryAsSnippetCommand}" Content="💾 現在のクエリを保存" Height="26" Padding="8,0" Margin="0,0,6,0"/>
                                    <Button Command="{Binding InsertSelectedSnippetCommand}" Content="📥 挿入 (Insert)" Height="26" Padding="8,0" Margin="0,0,6,0"/>
                                    <Button Command="{Binding DeleteSelectedSnippetCommand}" Content="🗑 削除" Height="26" Padding="8,0"/>
                                </StackPanel>
                                <ListBox Grid.Row="1" ItemsSource="{Binding SqlSnippets}" SelectedItem="{Binding SelectedSqlSnippet}" FontFamily="Consolas" FontSize="11" Margin="4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Sql}" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================================================================== -->
        <!-- 3. Status Bar Area                                                   -->
        <!-- ==================================================================== -->
        <StatusBar Grid.Row="2" x:Name="MainStatusBar" Height="26" Padding="6,2" Background="#007ACC" Foreground="White">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="White"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="NeoDB Studio v1.0 | SSMS-Style Engine" Foreground="White" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>