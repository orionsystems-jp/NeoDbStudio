<Application x:Class="NeoDbStudio.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:NeoDbStudio.Client"
             xmlns:converters="clr-namespace:NeoDbStudio.Client.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:DebugStateColorConverter x:Key="DebugStateColorConverter"/>
            <converters:DebugStateTextConverter x:Key="DebugStateTextConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
